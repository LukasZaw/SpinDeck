<Window x:Class="SpinDeck_Win_app.Windows.ActionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add action"
        Width="520"
        Height="470"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- ========================================== -->
        <!-- HEADER                                     -->
        <!-- ========================================== -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,25">

            <TextBlock x:Name="TitleText"
                       Text="Add Action"
                       FontSize="26"
                       FontWeight="SemiBold"/>

            <TextBlock Text="Configure your action for SpinDeck"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="13"
                       Margin="0,5,0,0"/>

        </StackPanel>


        <!-- ========================================== -->
        <!-- FORM                                       -->
        <!-- ========================================== -->

        <StackPanel Grid.Row="1">


            <!-- NAME -->

            <TextBlock Text="Action Name"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>

            <TextBox x:Name="NameTextBox"
                     Height="36"
                     Padding="10,5"
                     FontSize="14"
                     Margin="0,0,0,20"/>


            <!-- TYPE -->

            <TextBlock Text="Action Type"
                       FontWeight="SemiBold"
                       Margin="0,0,0,7"/>

            <ComboBox x:Name="TypeComboBox"
                      Height="36"
                      FontSize="14"
                      SelectionChanged="TypeComboBox_SelectionChanged"
                      Margin="0,0,0,20">

                <ComboBoxItem Tag="Browser">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🌐"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Browser"/>
                    </StackPanel>
                </ComboBoxItem>

                <ComboBoxItem Tag="Application">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="▣"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="Application"/>
                    </StackPanel>
                </ComboBoxItem>

            </ComboBox>


            <!-- BROWSER -->

            <StackPanel x:Name="BrowserPanel">

                <TextBlock Text="Page address"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <TextBox x:Name="BrowserTextBox"
                         Height="36"
                         Padding="10,5"
                         FontSize="14"/>

            </StackPanel>


            <!-- APPLICATION -->

            <StackPanel x:Name="ApplicationPanel"
                        Visibility="Collapsed">

                <TextBlock Text="Application"
                           FontWeight="SemiBold"
                           Margin="0,0,0,7"/>

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="ApplicationTextBox"
                             Grid.Column="0"
                             Height="36"
                             Padding="10,5"
                             FontSize="14"/>

                    <Button Grid.Column="1"
                            Content="Browse..."
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Width="100"
                            Margin="10,0,0,0"
                            Click="BrowseApplicationButton_Click"/>

                </Grid>

            </StackPanel>

        </StackPanel>


        <!-- ========================================== -->
        <!-- BUTTONS                                    -->
        <!-- ========================================== -->

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

                <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    FontSize="14"
                    Width="108"
                    Height="36"
                    Padding="10,4"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"/>

                <Button Content="Save"
                    FontWeight="SemiBold"
                    FontSize="14"
                    Width="108"
                    Height="36"
                    Padding="10,4"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>

</Window>