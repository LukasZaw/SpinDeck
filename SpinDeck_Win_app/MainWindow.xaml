<Window x:Class="SpinDeck_Win_app.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SpinDeck_Win_app.Views"
        Title="SpinDeck"
        Height="720"
        Width="1120"
        MinHeight="560"
        MinWidth="860"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>


        <!-- ========================================= -->
        <!-- LEFT SIDEBAR                              -->
        <!-- ========================================= -->

        <Border Grid.Column="0"
            Background="{StaticResource SidebarBrush}">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="110"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>


                <!-- LOGO / NAME -->

                <Border Grid.Row="0" Padding="24,22">

                    <StackPanel>
                        <TextBlock Text="SPINDECK"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"/>
                        <TextBlock Text="CONTROL SURFACE"
                                   Foreground="#8FB7AF"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                </Border>


                <!-- NAVIGATION -->

                <StackPanel Grid.Row="1" Margin="12,18,12,0">


                    <!-- DEVICE -->

                    <Button x:Name="DeviceButton"
                            Content="▣   Device"
                            Style="{StaticResource SidebarButton}"
                            Click="DeviceButton_Click">
                    </Button>

                    <!-- ACTIONS -->

                    <Button x:Name="ActionsButton"
                            Content="✦   Actions"
                            Style="{StaticResource SidebarButton}"
                            Click="ActionsButton_Click"/>


                    <!-- SETTINGS -->

                    <Button x:Name="SettingsButton"
                            Content="⚙   Settings"
                            Style="{StaticResource SidebarButton}"
                            Click="SettingsButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>


        <!-- ========================================= -->
        <!-- MAIN CONTENT                              -->
        <!-- ========================================= -->

        <Border Grid.Column="1"
            Background="{StaticResource WindowBackgroundBrush}"
            Padding="40,34,42,34">

            <ContentControl x:Name="MainContent"/>

        </Border>

    </Grid>

</Window>