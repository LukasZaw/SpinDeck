<UserControl x:Class="SpinDeck_Win_app.Views.ActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- ============================================= -->
        <!-- HEADER -->
        <!-- ============================================= -->

        <Grid Grid.Row="0"
              Margin="0,0,0,25">

            <StackPanel>

                <TextBlock Text="Actions"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="{StaticResource InkBrush}"/>

                <TextBlock Text="Actions configuration for SpinDeck device"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,7,0,0"/>

            </StackPanel>


                <Button Content="＋  Add action"
                        MinWidth="158"
                        Height="42"
                        Padding="12,6"
                    FontWeight="SemiBold"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Click="AddActionButton_Click"/>

        </Grid>


        <!-- ============================================= -->
        <!-- ACTION LIST -->
        <!-- ============================================= -->

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="ActionsItemsControl">

                <ItemsControl.ItemsPanel>

                    <ItemsPanelTemplate>

                        <StackPanel/>

                    </ItemsPanelTemplate>

                </ItemsControl.ItemsPanel>


                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                Margin="0,0,0,12">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>


                                <!-- ACTION INFORMATION -->

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource InkBrush}"/>


                                    <TextBlock Text="{Binding Type}"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"
                                               Margin="0,6,0,0"/>


                                    <TextBlock Text="{Binding Value}"
                                               FontSize="14"
                                               Margin="0,4,0,0"/>

                                </StackPanel>


                                <!-- DELETE -->

                                <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                                    <Button Content="Edit"
                                        Style="{StaticResource SecondaryButton}"
                                        Width="76"
                                        Height="34"
                                        Padding="8,4"
                                        Margin="0,0,8,0"
                                        Tag="{Binding}"
                                        Click="EditActionButton_Click"/>

                                    <Button Content="Delete"
                                        Style="{StaticResource DangerButton}"
                                        Width="76"
                                        Height="34"
                                        Padding="8,4"
                                        Tag="{Binding}"
                                        Click="DeleteActionButton_Click"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</UserControl>